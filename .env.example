# Copiar a .env y completar. El .env no se sube al repo.
POSTGRES_DB=greenfire
POSTGRES_USER=greenfire
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Administrador técnico inicial: se crea al arrancar solo si no existe ninguno.
# La contraseña debe tener al menos 10 caracteres. Opcional: ADMIN_NOMBRE (sin tildes: el .env se lee como
# ISO-8859-1); si no se indica, se usa "Administrador técnico". ADMIN_USUARIO: de 3 a 30 letras minúsculas,
# números, punto o guion bajo.
ADMIN_USUARIO=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Solo desarrollo: escribe en el log el link de recuperación de contraseña.
# En producción dejar en false (la contraseña la restablece el administrador técnico).
RECUPERACION_LOG_ENLACE=true

# En producción, true: la cookie de sesión solo viaja por HTTPS.
COOKIE_SECURE=false
