# Copiar a .env y completar. El .env no se sube al repo.
POSTGRES_DB=greenfire
POSTGRES_USER=greenfire
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Administrador técnico inicial: se crea al arrancar solo si no existe ninguno.
# La contraseña debe tener al menos 10 caracteres. Opcional: ADMIN_NOMBRE (sin tildes: el .env se lee como
# ISO-8859-1); si no se indica, se usa "Administrador técnico". ADMIN_USUARIO: de 3 a 30 letras minúsculas,
# números, punto o guion bajo.
ADMIN_USUARIO=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Solo desarrollo: escribe en el log el link de recuperación de contraseña.
# En producción dejar en false (la contraseña la restablece el administrador técnico).
RECUPERACION_LOG_ENLACE=true

# En producción, true: la cookie de sesión solo viaja por HTTPS.
COOKIE_SECURE=false

# --- Backups (ops/backups, ver docs/backups.md) ---
# Carpeta de los backups: ruta absoluta, fuera del repositorio. Se crea con permisos solo para el usuario.
BACKUP_DIR=
# Clave para cifrar los backups, de al menos 20 caracteres. Guardala también fuera del servidor (por ejemplo, en un
# gestor de contraseñas): sin ella, los backups no se pueden restaurar.
BACKUP_CLAVE_CIFRADO=
# Días que se conservan los backups. Por defecto, 30. El más reciente no se borra nunca.
BACKUP_RETENCION_DIAS=
# Opcional: nombre del contenedor de Docker donde correr pg_dump, pg_restore y psql, si no están instalados en el
# servidor (por ejemplo, el de docker compose en desarrollo).
BACKUP_PG_DOCKER=

# Copia fuera del servidor, opcional, en un almacenamiento compatible con S3 (por ejemplo, Backblaze B2).
# Se completan todas o ninguna. El endpoint empieza con https://.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
# Opcional: carpeta dentro del bucket, terminada en / (por ejemplo, diarios/).
BACKUP_S3_PREFIJO=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
