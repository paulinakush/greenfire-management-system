// Green Fire — modelo de datos
// Transcripto a texto desde "diagramas /Untitled-3.pdf" (dbdiagram.io) para
// tenerlo versionado como fuente de verdad. Adiciones respecto del diagrama
// original: pedidos.observaciones_internas, proveedores.activo, y — Fase A
// del roadmap hacia paridad con Fidel — comprobantes_venta/cobranzas
// (ventas con numeración fiscal), transferencias_stock, y la ampliación de
// Productos/Servicios (marcas, grupos, variantes, listas de precios).

Enum estado_pedido {
  pendiente
  confirmado
  rechazado
  en_preparacion
  listo_retiro
  pendiente_envio
  finalizado
}

Enum modalidad_entrega {
  retiro_sucursal
  envio_coordinado
}

Enum medio_pago {
  efectivo
  transferencia
  billetera_virtual
}

Enum tipo_insumo {
  materia_prima
  insumo
}

Enum tipo_compra {
  insumo
  producto
  mixta
}

Enum tipo_movimiento_stock {
  ingreso_mercaderia
  venta_presencial
  pedido_confirmado
  ajuste
  produccion
  compra_producto
}

Enum tipo_ubicacion_stock {
  sucursal
  fabrica
}

// --- Fase A: agregados sobre el diagrama original ---

Enum tipo_comprobante_venta {
  factura
  presupuesto
  recibo
  remito
}

Enum estado_comprobante {
  emitido
  anulado
}

Enum arca_estado {
  pendiente_integracion
}

Enum estado_transferencia {
  enviado
  recibido
}

Table roles {
  id int [pk, increment]
  nombre varchar
  descripcion text
}

Table permisos {
  id int [pk, increment]
  nombre varchar
  descripcion text
}

Table rol_permisos {
  id int [pk, increment]
  rol_id int
  permiso_id int
}

Table sucursales {
  id int [pk, increment]
  nombre varchar
  direccion varchar
  telefono varchar
  email varchar
  horarios varchar
  cuit varchar [note: 'agregado Fase A — cada sucursal tiene su propio CUIT/conexión ARCA, nunca consolidados']
}

Table usuarios {
  id int [pk, increment]
  nombre varchar
  email varchar
  password_hash varchar
  rol_id int
  sucursal_id int [note: 'null para administrativo_fabrica']
  activo boolean
}

Table categorias {
  id int [pk, increment]
  nombre varchar
  descripcion text
}

Table productos {
  id int [pk, increment]
  nombre varchar
  descripcion text
  precio decimal
  imagen varchar
  categoria_id int
  marca_id int [note: 'agregado Fase A']
  grupo_id int [note: 'agregado Fase A']
  es_fabricacion_propia boolean
  visible boolean
}

Table marcas {
  id int [pk, increment]
  nombre varchar
}

Table grupos {
  id int [pk, increment]
  nombre varchar
}

Table producto_variantes {
  id int [pk, increment]
  producto_id int
  nombre varchar
  note: 'Solo catálogo: todavía no está conectada a stock_productos ni a precios.'
}

Table listas_precios {
  id int [pk, increment]
  nombre varchar
  es_predeterminada boolean
}

Table lista_precios_items {
  id int [pk, increment]
  lista_id int
  producto_id int
  precio decimal
}

Table transferencias_stock {
  id int [pk, increment]
  origen_ubicacion_id int
  destino_ubicacion_id int
  usuario_id int
  fecha date
  estado estado_transferencia
  observaciones text
}

Table detalle_transferencia_stock {
  id int [pk, increment]
  transferencia_id int
  producto_id int
  cantidad int
}

Table comprobantes_venta {
  id int [pk, increment]
  tipo tipo_comprobante_venta
  punto_venta varchar
  numero int
  sucursal_id int
  cliente_id int
  usuario_id int
  fecha datetime
  estado estado_comprobante
  arca_estado arca_estado [note: 'solo se usa en tipo=factura; null en los demás porque no son fiscales']
  total decimal
  observaciones text
}

Table detalle_comprobante_venta {
  id int [pk, increment]
  comprobante_id int
  producto_id int
  cantidad int
  precio_unitario decimal
  subtotal decimal
}

Table cobranzas {
  id int [pk, increment]
  sucursal_id int
  cliente_id int
  usuario_id int
  fecha datetime
  medio_pago medio_pago
  monto decimal
  observaciones text
}

Table detalle_cobranza {
  id int [pk, increment]
  cobranza_id int
  comprobante_id int
  importe_aplicado decimal
}

Table ubicaciones_stock {
  id int [pk, increment]
  nombre varchar
  tipo tipo_ubicacion_stock
  sucursal_id int [note: 'null cuando tipo = fabrica (stock central)']
}

Table stock_productos {
  id int [pk, increment]
  producto_id int
  ubicacion_stock_id int
  cantidad_actual int
  stock_minimo int
  stock_maximo int
}

Table movimientos_stock {
  id int [pk, increment]
  stock_producto_id int
  usuario_id int
  tipo_movimiento tipo_movimiento_stock
  cantidad int
  fecha_hora datetime
  motivo varchar
  observaciones text
}

Table clientes {
  id int [pk, increment]
  nombre varchar
  telefono varchar
  email varchar
}

Table pedidos {
  id int [pk, increment]
  cliente_id int
  sucursal_id int
  fecha datetime
  modalidad modalidad_entrega
  estado estado_pedido
  pago_habilitado boolean [note: 'true recién cuando estado pasa a confirmado']
  total decimal
  observaciones text [note: 'observaciones cargadas por el cliente']
  observaciones_internas text [note: 'notas internas de la sucursal, no visibles para el cliente']
}

Table detalle_pedidos {
  id int [pk, increment]
  pedido_id int
  producto_id int
  cantidad int
  precio_unitario decimal
  subtotal decimal
}

Table ventas {
  id int [pk, increment]
  sucursal_id int
  usuario_id int
  fecha_hora datetime
  medio_pago medio_pago
  total decimal
}

Table detalle_ventas {
  id int [pk, increment]
  venta_id int
  producto_id int
  cantidad int
  precio_unitario decimal
  subtotal decimal
}

Table cierres_caja {
  id int [pk, increment]
  sucursal_id int
  usuario_id int
  fecha date
  total_efectivo decimal
  total_transferencia decimal
  total_billetera decimal
  total_general decimal
  observaciones text
}

Table proveedores {
  id int [pk, increment]
  razon_social varchar
  contacto varchar
  tipo_provee varchar
  observaciones text
  activo boolean [note: 'agregado sobre el diagrama original: soporta desactivar un proveedor sin borrarlo']
}

Table insumos {
  id int [pk, increment]
  nombre varchar
  tipo tipo_insumo
  unidad_medida varchar
  stock decimal
}

Table compras {
  id int [pk, increment]
  proveedor_id int
  usuario_id int
  ubicacion_stock_id int
  fecha date
  tipo tipo_compra
  costo_total decimal
  observaciones text
}

Table detalle_compra_insumos {
  id int [pk, increment]
  compra_id int
  insumo_id int
  cantidad decimal
  costo_unitario decimal
  subtotal decimal
}

Table detalle_compra_productos {
  id int [pk, increment]
  compra_id int
  producto_id int
  cantidad int
  costo_unitario decimal
  subtotal decimal
}

Table producciones {
  id int [pk, increment]
  producto_id int
  usuario_id int
  ubicacion_stock_id int
  fecha date
  cantidad_producida int
  observaciones text
}

Table produccion_insumos {
  id int [pk, increment]
  produccion_id int
  insumo_id int
  cantidad_consumida decimal
}

Table auditorias {
  id int [pk, increment]
  usuario_id int
  accion varchar
  entidad varchar
  fecha_hora datetime
}

Ref: rol_permisos.rol_id > roles.id
Ref: rol_permisos.permiso_id > permisos.id
Ref: usuarios.rol_id > roles.id
Ref: usuarios.sucursal_id > sucursales.id
Ref: productos.categoria_id > categorias.id
Ref: ubicaciones_stock.sucursal_id > sucursales.id
Ref: stock_productos.producto_id > productos.id
Ref: stock_productos.ubicacion_stock_id > ubicaciones_stock.id
Ref: movimientos_stock.stock_producto_id > stock_productos.id
Ref: movimientos_stock.usuario_id > usuarios.id
Ref: pedidos.cliente_id > clientes.id
Ref: pedidos.sucursal_id > sucursales.id
Ref: detalle_pedidos.pedido_id > pedidos.id
Ref: detalle_pedidos.producto_id > productos.id
Ref: ventas.sucursal_id > sucursales.id
Ref: ventas.usuario_id > usuarios.id
Ref: detalle_ventas.venta_id > ventas.id
Ref: detalle_ventas.producto_id > productos.id
Ref: cierres_caja.sucursal_id > sucursales.id
Ref: cierres_caja.usuario_id > usuarios.id
Ref: compras.proveedor_id > proveedores.id
Ref: compras.usuario_id > usuarios.id
Ref: compras.ubicacion_stock_id > ubicaciones_stock.id
Ref: detalle_compra_insumos.compra_id > compras.id
Ref: detalle_compra_insumos.insumo_id > insumos.id
Ref: detalle_compra_productos.compra_id > compras.id
Ref: detalle_compra_productos.producto_id > productos.id
Ref: producciones.producto_id > productos.id
Ref: producciones.usuario_id > usuarios.id
Ref: producciones.ubicacion_stock_id > ubicaciones_stock.id
Ref: produccion_insumos.produccion_id > producciones.id
Ref: produccion_insumos.insumo_id > insumos.id
Ref: auditorias.usuario_id > usuarios.id

Ref: productos.marca_id > marcas.id
Ref: productos.grupo_id > grupos.id
Ref: producto_variantes.producto_id > productos.id
Ref: lista_precios_items.lista_id > listas_precios.id
Ref: lista_precios_items.producto_id > productos.id
Ref: transferencias_stock.origen_ubicacion_id > ubicaciones_stock.id
Ref: transferencias_stock.destino_ubicacion_id > ubicaciones_stock.id
Ref: transferencias_stock.usuario_id > usuarios.id
Ref: detalle_transferencia_stock.transferencia_id > transferencias_stock.id
Ref: detalle_transferencia_stock.producto_id > productos.id
Ref: comprobantes_venta.sucursal_id > sucursales.id
Ref: comprobantes_venta.cliente_id > clientes.id
Ref: comprobantes_venta.usuario_id > usuarios.id
Ref: detalle_comprobante_venta.comprobante_id > comprobantes_venta.id
Ref: detalle_comprobante_venta.producto_id > productos.id
Ref: cobranzas.sucursal_id > sucursales.id
Ref: cobranzas.cliente_id > clientes.id
Ref: cobranzas.usuario_id > usuarios.id
Ref: detalle_cobranza.cobranza_id > cobranzas.id
Ref: detalle_cobranza.comprobante_id > comprobantes_venta.id
