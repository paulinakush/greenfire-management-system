// Green Fire — modelo de datos
// Fuente de verdad única del modelo. Se apoya en el informe original
// (docs/SegundoIndormePP.pdf) y en docs/complemento.md; si se contradicen,
// manda el complemento.
//
// Decisiones de diseño:
// - Ámbitos: la fábrica y cada local son un ámbito, cada uno con su entidad
//   fiscal. Un usuario puede tener un perfil distinto en cada ámbito.
// - Perfiles fijos (no hay tabla de permisos): se validan en el servidor.
// - Artículos: insumos, productos terminados y mercadería de reventa en una
//   sola tabla, con un único stock y un único registro de movimientos.
// - Todo movimiento de mercadería entre ámbitos es una entrega con precio y
//   comprobante; no existen transferencias sin precio.
// - El stock actual es la suma de los movimientos. El lote viaja en los
//   movimientos y en el detalle de cada entrega; no hay stock por lote.
// - La venta es la operación; el comprobante fiscal es opcional.
// - Los saldos (clientes, proveedores, fábrica-local) se calculan desde
//   movimientos y nunca se guardan como valor editable.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum tipo_ambito {
  fabrica
  local
}

Enum perfil_usuario {
  dueno_fabrica
  dueno_local
  empleado_local
}

Enum condicion_iva {
  responsable_inscripto
  monotributo
  exento
  consumidor_final
}

Enum tipo_articulo {
  insumo
  producto_terminado
  reventa
}

Enum unidad_medida {
  unidad [note: 'las bolsas de 80 dm³ se venden como unidad']
  kg
  litro
  m3
  dm3
}

Enum estado_pedido {
  pendiente
  confirmado
  rechazado
  en_preparacion
  listo_retiro
  pendiente_envio
  finalizado
  cancelado
  vencido
}

Enum estado_pago_pedido {
  no_habilitado
  habilitado
  pagado
}

Enum modalidad_entrega {
  retiro_sucursal
  envio_coordinado
}

Enum medio_pago {
  efectivo
  transferencia
  billetera_virtual
  cuenta_corriente
}

Enum estado_reserva {
  activa
  consumida
  liberada
}

Enum tipo_movimiento_stock {
  venta
  entrega_pedido
  compra
  entrega_salida
  entrega_recepcion
  produccion_consumo
  produccion_ingreso
  ajuste
  conteo
  anulacion
  devolucion
}

Enum estado_venta {
  confirmada
  anulada
}

Enum tipo_comprobante {
  factura
  nota_credito
  nota_debito
  remito
  recibo
  presupuesto
  comprobante_venta [note: 'comprobante simple de una venta, solo letra X']
}

Enum letra_comprobante {
  A
  B
  C
  X
}

Enum estado_comprobante {
  emitido
  anulado
}

Enum arca_estado {
  pendiente
  autorizado
  rechazado
}

Enum estado_entrega {
  enviada
  recibida
  diferencia_informada
  anulada
}

Enum resolucion_diferencia {
  reingreso [note: 'el faltante vuelve al stock de la fábrica (movimiento devolucion)']
  perdida [note: 'el faltante se da por perdido; no genera movimiento']
}

Enum tipo_movimiento_cc {
  venta
  entrega
  cobranza
  nota_credito
  ajuste
}

Enum estado_caja {
  abierta
  cerrada
}

Enum tipo_movimiento_caja {
  ingreso
  egreso
}

Enum origen_movimiento_caja {
  manual [note: 'ingreso o egreso cargado a mano, con rubro']
  venta
  cobranza
  devolucion [note: 'devolución o anulación de una venta']
}

Enum rubro_caja {
  gasto
  retiro
  aporte
  pago_fabrica
  otro
}

Enum tipo_compra {
  insumos_produccion
  mercaderia_reventa
}

Enum estado_orden_compra {
  borrador
  enviada
  recibida
  cancelada
}

Enum estado_lote {
  abierto
  cerrado
}

Enum estado_conteo {
  abierto
  cerrado
  anulado
}

// ---------------------------------------------------------------------------
// Entidades fiscales, ámbitos y usuarios
// ---------------------------------------------------------------------------

Table entidades_fiscales {
  id int [pk, increment]
  razon_social varchar
  cuit varchar [unique]
  condicion_iva condicion_iva
  domicilio_fiscal varchar
  arca_certificado_ref varchar [note: 'referencia al certificado digital guardado fuera de la base']
  arca_certificado_vence date
  activo boolean
  created_at datetime
  updated_at datetime
}

Table ambitos {
  id int [pk, increment]
  tipo tipo_ambito
  nombre varchar
  entidad_fiscal_id int
  direccion varchar
  telefono varchar
  email varchar
  horarios varchar
  visible_web boolean [note: 'los locales que aparecen en "Sucursales" y se pueden elegir en un pedido']
  es_central boolean [note: 'el local que el catálogo público usa por defecto: a lo sumo uno, y tiene que ser un local activo y visible en la web. Lo cambia solo el administrador técnico']
  descuento_maximo_empleado decimal [note: 'porcentaje de 0 a 100, 0 por defecto: el descuento máximo que el empleado aplica en una venta. Solo tiene sentido en los locales; lo edita el dueño de local, con auditoría']
  activo boolean
  created_at datetime
  updated_at datetime
  note: 'Reemplaza a la tabla sucursales: un local es un ámbito de tipo local.'
}

Table puntos_venta {
  id int [pk, increment]
  entidad_fiscal_id int
  ambito_id int
  numero int
  descripcion varchar
  activo boolean
  created_at datetime
  updated_at datetime

  indexes {
    (entidad_fiscal_id, numero) [unique]
  }
}

Table punto_venta_comprobantes {
  id int [pk, increment]
  punto_venta_id int
  tipo tipo_comprobante
  letra letra_comprobante
  ultimo_numero int [note: 'último número emitido de ese tipo y letra en el punto de venta; se toma con SELECT ... FOR UPDATE al emitir, sin huecos']
  created_at datetime
  updated_at datetime
  note: 'Tipos de comprobante que puede emitir cada punto de venta según la condición fiscal de su entidad. comprobante_venta solo en letra X y factura nunca en X.'

  indexes {
    (punto_venta_id, tipo, letra) [unique]
  }
}

Table usuarios {
  id int [pk, increment]
  nombre varchar
  usuario varchar [note: 'para el login, junto con el email: único sin distinguir mayúsculas, de 3 a 30 letras minúsculas, números, punto o guion bajo']
  email varchar [unique, note: 'para el login y la recuperación de contraseña']
  password_hash varchar
  es_admin_tecnico boolean [note: 'crea las cuentas de los dueños; no ve datos comerciales de ningún ámbito']
  activo boolean
  intentos_fallidos int
  bloqueado_hasta datetime
  reset_token_hash varchar
  reset_token_vence datetime
  ultimo_acceso datetime
  created_at datetime
  updated_at datetime
}

Table usuario_ambitos {
  id int [pk, increment]
  usuario_id int
  ambito_id int
  perfil perfil_usuario [note: 'dueno_fabrica solo en ámbitos tipo fabrica; dueno_local y empleado_local solo en tipo local']
  activo boolean
  creado_por_usuario_id int
  created_at datetime
  updated_at datetime

  indexes {
    (usuario_id, ambito_id) [unique]
  }
}

Table auditorias {
  id int [pk, increment]
  usuario_id int
  perfil perfil_usuario [note: 'perfil con el que actuaba; null para el administrador técnico']
  ambito_id int [note: 'ámbito activo de quien actúa']
  ambito_afectado_id int [note: 'ámbito que toca la acción (alta, edición o desactivación); si toca varios, un registro por ámbito']
  accion varchar
  entidad varchar
  entidad_id int
  detalle text
  fecha_hora datetime
  email_intentado varchar [note: 'login fallido: lo que se escribió en el campo (usuario o email), corresponda o no a un usuario']
  ip varchar
  created_at datetime
  updated_at datetime
  note: 'Solo inserción: la base rechaza UPDATE, DELETE y TRUNCATE. El detalle nunca guarda contraseñas, hashes, tokens ni datos del certificado de ARCA.'
}

// ---------------------------------------------------------------------------
// Catálogo y precios
// ---------------------------------------------------------------------------

Table categorias {
  id int [pk, increment]
  nombre varchar [note: 'único sin distinguir mayúsculas']
  descripcion text
  activo boolean
  created_at datetime
  updated_at datetime
  note: 'Comunes a todos los ámbitos; las administra el dueño de fábrica.'
}

Table articulos {
  id int [pk, increment]
  ambito_id int [note: 'dueño del artículo: la fábrica para insumos y productos terminados, un local para reventa']
  tipo tipo_articulo [note: 'no cambia después del alta']
  nombre varchar
  descripcion text
  categoria_id int [note: 'null para insumos y obligatoria para los demás']
  marca varchar [note: 'opcional']
  unidad_medida unidad_medida
  imagen varchar [note: 'ruta dentro de assets/productos/']
  alicuota_iva decimal [note: '0, 10.5, 21 o 27']
  visible_web boolean [note: 'siempre false para insumos']
  activo boolean
  created_at datetime
  updated_at datetime

  indexes {
    (ambito_id, nombre) [unique, note: 'sin distinguir mayúsculas']
  }
  note: 'La fábrica ve sus artículos. Cada local ve los productos terminados de la fábrica y su propia reventa, nunca la de otro local.'
}

Table costos_articulo {
  id int [pk, increment]
  articulo_id int
  ambito_id int
  costo_actual decimal
  created_at datetime
  updated_at datetime

  indexes {
    (articulo_id, ambito_id) [unique]
  }
  note: 'Costo de un artículo en un ámbito; cada ámbito ve solo el suyo. En la fábrica, se carga a mano hasta la etapa 4 (compras y cierre de lote). En un local: la reventa, a mano hasta la etapa 4; el producto terminado, el precio unitario de la última entrega recibida, tal cual, sin ajustes de IVA (el tratamiento del IVA lo confirma el contador en la etapa 3). El promedio ponderado se evalúa en la etapa 4.'
}

Table listas_precios {
  id int [pk, increment]
  ambito_id int [note: 'dueño de la lista: la fábrica (lista para locales) o un local']
  nombre varchar [note: 'único dentro del ámbito, sin distinguir mayúsculas']
  precios_con_iva boolean [note: 'siempre true si la entidad del ámbito no discrimina IVA: el precio de la lista es el precio final. Solo se cambia mientras la lista no tiene precios']
  es_predeterminada boolean [note: 'lista de venta al público del ámbito; una sola por ámbito y siempre activa']
  activo boolean
  created_at datetime
  updated_at datetime

  indexes {
    (ambito_id, nombre) [unique, note: 'sin distinguir mayúsculas']
    ambito_id [unique, note: 'índice parcial: solo donde es_predeterminada']
  }
}

Table lista_precios_items {
  id int [pk, increment]
  lista_id int
  articulo_id int [note: 'un producto terminado de la fábrica o la reventa del ámbito de la lista; nunca un insumo']
  precio decimal [note: 'mayor que cero; con o sin IVA según la lista']
  created_at datetime
  updated_at datetime

  indexes {
    (lista_id, articulo_id) [unique]
  }
  note: 'Sacar un artículo de la lista borra su fila; el historial la conserva.'
}

Table historial_precios {
  id int [pk, increment]
  lista_id int
  articulo_id int
  precio_anterior decimal [note: 'null al agregar el artículo a la lista']
  precio_nuevo decimal [note: 'null al sacar el artículo de la lista']
  usuario_id int
  fecha_hora datetime
  created_at datetime
  updated_at datetime
  note: 'Solo inserción: la base rechaza UPDATE, DELETE y TRUNCATE.'
}

Table promociones {
  id int [pk, increment]
  ambito_id int
  nombre varchar
  articulo_id int [note: 'null si aplica a una categoría']
  categoria_id int [note: 'null si aplica a un artículo']
  porcentaje_descuento decimal
  fecha_inicio date
  fecha_fin date
  activo boolean
  created_at datetime
  updated_at datetime
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

Table ubicaciones_stock {
  id int [pk, increment]
  ambito_id int
  nombre varchar [note: 'único dentro del ámbito, sin distinguir mayúsculas']
  activo boolean [note: 'no se desactiva mientras tenga stock']
  created_at datetime
  updated_at datetime

  indexes {
    (ambito_id, nombre) [unique, note: 'sin distinguir mayúsculas']
  }
  note: 'Cada ámbito nace con una ubicación "Principal", creada por la base al dar de alta el ámbito.'
}

Table stock_articulos {
  id int [pk, increment]
  articulo_id int [note: 'un artículo que el ámbito de la ubicación ve: los suyos y, en un local, los productos terminados de la fábrica']
  ubicacion_stock_id int
  stock_minimo decimal [note: 'opcional, no negativo']
  stock_maximo decimal [note: 'opcional, no menor que el mínimo']
  cantidad_actual decimal [note: 'caché de la suma de movimientos_stock, que mantiene un trigger; nunca negativa y no se edita a mano']
  created_at datetime
  updated_at datetime

  indexes {
    (articulo_id, ubicacion_stock_id) [unique]
  }
}

Table movimientos_stock {
  id int [pk, increment]
  articulo_id int
  ubicacion_stock_id int
  tipo tipo_movimiento_stock
  cantidad decimal [note: 'positiva si entra, negativa si sale; nunca cero; entera si la unidad es unidad']
  lote_id int [note: 'lote del producto terminado; en produccion_consumo, el lote que consumió el insumo. Sin FK hasta la etapa 4']
  usuario_id int
  fecha_hora datetime
  motivo varchar [note: 'obligatorio cuando tipo = ajuste']
  venta_id int [note: 'obligatorio si tipo = venta; anulacion y devolucion llevan venta_id o entrega_id, uno solo y nunca los dos. En una venta, de la ubicación y el artículo de un renglón: la venta resta, la anulación y la devolución suman']
  pedido_id int [note: 'se agrega en la etapa 3']
  compra_id int [note: 'se agrega en la etapa 4']
  entrega_id int [note: 'obligatorio si tipo es entrega_salida o entrega_recepcion; en anulacion y devolucion, entrega_id o venta_id, uno solo. Salida, anulación y devolución en la ubicación de origen, recepción en la de destino']
  conteo_id int [note: 'obligatorio si y solo si tipo = conteo; de un conteo de la misma ubicación']
  observaciones text
  created_at datetime
  updated_at datetime
  note: 'Solo inserción: la base rechaza UPDATE, DELETE y TRUNCATE. Cada movimiento suma su cantidad a stock_articulos.cantidad_actual en la misma transacción.'
}

Table reservas_stock {
  id int [pk, increment]
  pedido_id int
  detalle_pedido_id int
  articulo_id int
  ubicacion_stock_id int
  cantidad decimal
  estado estado_reserva
  created_at datetime
  cerrada_at datetime [note: 'cuando pasa a consumida o liberada']
  updated_at datetime
  note: 'Se crea al confirmar el pedido, se consume al entregarlo o cobrarlo y se libera si se rechaza, cancela o vence. Disponible = cantidad_actual − reservas activas.'
}

Table conteos_stock {
  id int [pk, increment]
  ubicacion_stock_id int
  usuario_id int [note: 'quien lo abrió']
  fecha date [note: 'día de apertura, en la zona horaria de la empresa']
  estado estado_conteo
  observaciones text
  cerrado_at datetime [note: 'solo si está cerrado']
  anulado_at datetime [note: 'solo si está anulado']
  created_at datetime
  updated_at datetime

  indexes {
    ubicacion_stock_id [unique, note: 'índice parcial: un solo conteo abierto por ubicación']
  }
  note: 'Un conteo cerrado o anulado no se modifica, y ningún conteo se borra (la base lo rechaza).'
}

Table detalle_conteo {
  id int [pk, increment]
  conteo_id int
  articulo_id int [note: 'un artículo que el ámbito de la ubicación ve']
  cantidad_sistema decimal [note: 'se toma al cerrar; null mientras está abierto']
  cantidad_contada decimal [note: 'no negativa; entera si la unidad es unidad']
  created_at datetime
  updated_at datetime

  indexes {
    (conteo_id, articulo_id) [unique]
  }
  note: 'Solo se carga mientras el conteo está abierto. Al cerrar, cada diferencia distinta de cero genera un movimiento tipo conteo.'
}

// ---------------------------------------------------------------------------
// Clientes y pedidos online
// ---------------------------------------------------------------------------

Table clientes {
  id int [pk, increment]
  ambito_id int [note: 'ámbito dueño del cliente: cada local tiene sus clientes; la fábrica, los locales y sus mayoristas. Nunca cambia']
  nombre varchar [note: 'obligatorio, salvo que haya razón social']
  razon_social varchar
  documento_tipo varchar [note: 'cuit (11 dígitos) o dni (7 u 8 dígitos); los dos o ninguno']
  documento_numero varchar
  condicion_iva condicion_iva [note: 'consumidor_final por defecto']
  telefono varchar
  email varchar
  direccion varchar
  cuenta_corriente_habilitada boolean [note: 'solo con documento; siempre true en los clientes que representan a un local']
  limite_credito decimal [note: 'opcional, no negativo; null es sin límite; siempre null en los clientes que representan a un local']
  lista_precios_id int [note: 'una lista del mismo ámbito del cliente']
  plazo_pago_dias int [note: 'opcional, no negativo']
  ambito_representado_id int [note: 'el local que representa, cuando es cliente de la fábrica; lo crea la base, uno por local, con los datos del local y de su entidad fiscal']
  activo boolean
  created_at datetime
  updated_at datetime

  indexes {
    (ambito_id, documento_tipo, documento_numero) [unique, note: 'índice parcial: solo con documento y sin los que representan a un local (dos locales pueden compartir entidad fiscal)']
    ambito_representado_id [unique, note: 'índice parcial: un cliente por local']
  }
  note: 'Las cuentas web de los clientes van en una tabla aparte (etapa posterior). Ningún cliente se borra: se desactiva.'
}

Table pedidos {
  id int [pk, increment]
  cliente_id int
  ambito_id int [note: 'local al que se asignó el pedido']
  fecha datetime
  modalidad modalidad_entrega
  estado estado_pedido
  estado_pago estado_pago_pedido [note: 'pasa a habilitado recién cuando el pedido se confirma']
  medio_pago_elegido medio_pago
  vence_at datetime [note: 'si llega sin pago, el pedido pasa a vencido y libera la reserva']
  total decimal
  observaciones text [note: 'observaciones cargadas por el cliente']
  observaciones_internas text [note: 'notas internas del local, no visibles para el cliente']
  created_at datetime
  updated_at datetime
}

Table detalle_pedidos {
  id int [pk, increment]
  pedido_id int
  articulo_id int
  cantidad decimal
  precio_unitario decimal
  subtotal decimal
  created_at datetime
  updated_at datetime
}

Table pedido_historial {
  id int [pk, increment]
  pedido_id int
  usuario_id int [note: 'null si el cambio lo hizo el sistema (por ejemplo, vencimiento)']
  estado_anterior estado_pedido
  estado_nuevo estado_pedido
  ambito_anterior_id int [note: 'solo en reasignaciones']
  ambito_nuevo_id int
  fecha_hora datetime
  observacion text
  created_at datetime
  updated_at datetime
}

// ---------------------------------------------------------------------------
// Ventas y comprobantes
// ---------------------------------------------------------------------------

Table ventas {
  id int [pk, increment]
  ambito_id int [note: 'un local (venta presencial) o la fábrica (venta a un mayorista)']
  usuario_id int
  cliente_id int [note: 'del mismo ámbito; opcional en un local, obligatorio en la fábrica; nunca el cliente que representa a un local (eso es una entrega)']
  pedido_id int [note: 'cuando la venta concreta un pedido online; se agrega con los pedidos (módulo 9)']
  sesion_caja_id int [note: 'la caja abierta del local al vender, si el medio no es cuenta corriente; null en la fábrica, que no tiene caja']
  fecha_hora datetime
  medio_pago medio_pago [note: 'cuenta_corriente se habilita con el módulo 7']
  fecha_cobro date [note: 'solo en la fábrica, que no tiene caja: la fecha del cobro']
  subtotal decimal [note: 'suma de los renglones al precio de lista, antes del descuento']
  porcentaje_descuento decimal [note: 'de 0 a 100, uno por venta; el empleado, hasta descuento_maximo_empleado de su local']
  descuento decimal [note: 'subtotal - total']
  total decimal [note: 'suma de los subtotales de los renglones; igual al total del comprobante']
  estado estado_venta [note: 'nace confirmada y solo pasa a anulada, una vez']
  comprobante_id int [note: 'el comprobante de la venta, X en la etapa 3 (comprobante_venta) o fiscal desde la etapa 6; uno por venta']
  anulada_por_usuario_id int
  anulada_at datetime
  motivo_anulacion text [note: 'obligatorio al anular']
  created_at datetime
  updated_at datetime

  indexes {
    comprobante_id [unique]
    (ambito_id, fecha_hora)
  }
  note: 'Solo de inserción, salvo el paso de confirmada a anulada; no se borra. Una venta con devoluciones no se anula: el resto se devuelve.'
}

Table detalle_ventas {
  id int [pk, increment]
  venta_id int
  articulo_id int [note: 'un producto terminado de la fábrica o la reventa del local; nunca un insumo. En la fábrica, solo productos terminados']
  ubicacion_stock_id int [note: 'de donde sale el stock, del ámbito de la venta; "Principal" si no se indica']
  cantidad decimal [note: 'mayor que cero; entera si la unidad es unidad']
  precio_lista decimal [note: 'precio final de la lista, con IVA si la entidad lo discrimina, antes del descuento']
  precio_unitario decimal [note: 'precio final del renglón, con el descuento de la venta, redondeado a centavos']
  alicuota_iva decimal [note: 'copiada del artículo al vender']
  costo_unitario decimal [note: 'costo del ámbito al momento de la venta, para calcular el margen; null si no tenía']
  subtotal decimal [note: 'round(cantidad * precio_unitario, 2), igual que en el comprobante']
  created_at datetime
  updated_at datetime

  indexes {
    (venta_id, articulo_id, ubicacion_stock_id) [unique]
  }
  note: 'Solo se inserta, en la misma transacción que la venta; no se modifica ni se borra.'
}

Table devoluciones_venta {
  id int [pk, increment]
  venta_id int [note: 'una venta confirmada']
  usuario_id int
  fecha_hora datetime
  motivo text [note: 'obligatorio']
  total decimal [note: 'suma de los renglones devueltos; igual al total de la nota de crédito']
  nota_credito_id int [note: 'nota de crédito X que referencia al comprobante de la venta']
  sesion_caja_id int [note: 'la caja abierta del local donde se devolvió el dinero; null en la fábrica']
  created_at datetime
  updated_at datetime
  note: 'Devolución parcial de una venta, por renglones. Solo de inserción.'
}

Table detalle_devoluciones_venta {
  id int [pk, increment]
  devolucion_id int
  detalle_venta_id int [note: 'un renglón de la misma venta']
  cantidad decimal [note: 'mayor que cero; lo devuelto de un renglón nunca supera lo vendido']
  subtotal decimal [note: 'round(cantidad * precio_unitario del renglón, 2)']
  created_at datetime
  updated_at datetime
  note: 'Solo de inserción.'
}

Table comprobantes {
  id int [pk, increment]
  tipo tipo_comprobante
  letra letra_comprobante
  punto_venta_id int [note: 'define la entidad emisora y el ámbito']
  numero int [note: 'correlativo por punto de venta, tipo y letra, sin huecos']
  emisor_razon_social varchar [note: 'datos del emisor (entidad fiscal y ámbito) copiados al emitir']
  emisor_cuit varchar
  emisor_condicion_iva condicion_iva [note: 'decide si el comprobante discrimina IVA']
  emisor_domicilio_fiscal varchar
  emisor_nombre varchar [note: 'nombre del ámbito: la fábrica o el local']
  emisor_direccion varchar
  cliente_id int [note: 'del ámbito del punto de venta; null para un consumidor final sin identificar']
  receptor_razon_social varchar [note: 'datos del receptor copiados al emitir']
  receptor_documento_tipo varchar [note: 'cuit o dni, como en clientes']
  receptor_documento varchar
  receptor_condicion_iva condicion_iva
  receptor_domicilio varchar
  usuario_id int
  fecha datetime
  fecha_vencimiento date
  estado estado_comprobante [note: 'emitido pasa a anulado, una vez; nada más cambia y no se borra']
  anulado_por_usuario_id int
  anulado_at datetime
  motivo_anulacion text
  comprobante_asociado_id int [note: 'comprobante de la misma entidad que corrige una nota de crédito o de débito']
  precios_con_iva boolean [note: 'si los precios del detalle incluyen IVA; siempre true si el emisor no discrimina IVA']
  neto decimal [note: 'igual al total si el emisor no discrimina IVA']
  iva decimal [note: '0 si el emisor no discrimina IVA']
  total decimal
  arca_estado arca_estado [note: 'null en comprobantes no fiscales']
  cae varchar
  cae_vence date
  observaciones text
  created_at datetime
  updated_at datetime

  indexes {
    (punto_venta_id, tipo, letra, numero) [unique]
  }
}

Table detalle_comprobante {
  id int [pk, increment]
  comprobante_id int
  articulo_id int [note: 'opcional: un recibo o un ajuste no llevan artículo']
  descripcion varchar [note: 'copiada al emitir']
  cantidad decimal
  precio_unitario decimal [note: 'con o sin IVA según comprobantes.precios_con_iva']
  alicuota_iva decimal
  subtotal decimal [note: 'cantidad por precio unitario, redondeado a centavos']
  created_at datetime
  updated_at datetime
  note: 'Se carga al emitir, en la misma transacción que el comprobante; después no cambia ni se borra.'
}

// ---------------------------------------------------------------------------
// Entregas entre ámbitos (venta de la fábrica a los locales)
// ---------------------------------------------------------------------------

Table entregas {
  id int [pk, increment]
  ambito_origen_id int
  ambito_destino_id int
  ubicacion_origen_id int
  ubicacion_destino_id int [note: 'la elige el local al recibir; de su ámbito']
  lista_precios_id int [note: 'lista de la fábrica de la que sale el precio']
  estado estado_entrega [note: 'enviada pasa a recibida, diferencia_informada o anulada; ningún otro cambio']
  usuario_envio_id int
  fecha_envio datetime
  usuario_recepcion_id int
  fecha_recepcion datetime
  usuario_anulacion_id int
  anulada_at datetime [note: 'solo una entrega enviada, antes de la recepción']
  remito_id int [note: 'comprobante tipo remito, con precio, del ámbito origen; se agrega en la etapa 3']
  factura_id int [note: 'según la condición fiscal; se asocia al remito y no suma deuda; etapa 3']
  nota_credito_id int [note: 'cuando la fábrica resuelve una diferencia con nota de crédito; etapa 3']
  resolucion_diferencia resolucion_diferencia [note: 'solo en diferencia_informada; una vez resuelta no cambia']
  motivo_resolucion varchar [note: 'obligatorio al resolver']
  usuario_resolucion_id int
  diferencia_resuelta_at datetime
  total decimal [note: 'suma de los subtotales de lo enviado']
  observaciones text
  observaciones_recepcion text [note: 'diferencias informadas por el destino']
  created_at datetime
  updated_at datetime
  note: 'El stock sale del origen al enviar y entra al destino recién al confirmar la recepción, valuado al precio de la entrega.'
}

Table detalle_entregas {
  id int [pk, increment]
  entrega_id int
  articulo_id int
  lote_id int
  cantidad_enviada decimal [note: 'mayor que cero']
  cantidad_recibida decimal [note: 'la carga el destino al confirmar la recepción, una sola vez; nunca mayor que la enviada']
  precio_unitario decimal [note: 'el de la lista de la fábrica al enviar']
  subtotal decimal [note: 'cantidad_enviada × precio_unitario, redondeado a dos decimales']
  created_at datetime
  updated_at datetime

  indexes {
    (entrega_id, articulo_id, lote_id) [unique, note: 'un renglón por artículo y lote']
  }
  note: 'Solo productos terminados del ámbito origen. No se borra.'
}

// ---------------------------------------------------------------------------
// Cuentas corrientes y cobranzas
// ---------------------------------------------------------------------------

Table movimientos_cuenta_corriente {
  id int [pk, increment]
  ambito_id int [note: 'ámbito acreedor (quien cobra)']
  cliente_id int
  tipo tipo_movimiento_cc
  importe decimal [note: 'positivo aumenta la deuda del cliente, negativo la reduce']
  fecha datetime
  vence date
  venta_id int
  entrega_id int
  cobranza_id int
  comprobante_id int
  usuario_id int
  observaciones text
  created_at datetime
  updated_at datetime
  note: 'Saldo del cliente = suma de importes. Incluye la cuenta corriente de cada local con la fábrica.'
}

Table cobranzas {
  id int [pk, increment]
  ambito_id int
  cliente_id int
  usuario_id int
  sesion_caja_id int
  fecha datetime
  medio_pago medio_pago
  monto decimal
  recibo_id int [note: 'comprobante tipo recibo']
  observaciones text
  created_at datetime
  updated_at datetime
}

Table detalle_cobranza {
  id int [pk, increment]
  cobranza_id int
  movimiento_cc_id int [note: 'deuda a la que se imputa el pago']
  importe_aplicado decimal
  created_at datetime
  updated_at datetime
}

// ---------------------------------------------------------------------------
// Caja
// ---------------------------------------------------------------------------

Table sesiones_caja {
  id int [pk, increment]
  ambito_id int [note: 'solo locales: la fábrica no tiene caja']
  usuario_apertura_id int
  usuario_cierre_id int
  abierta_at datetime
  cerrada_at datetime
  saldo_inicial decimal
  total_efectivo decimal [note: 'cobros netos en efectivo: ventas + cobranzas - devoluciones']
  total_transferencia decimal [note: 'cobros netos por transferencia; no suman al efectivo']
  total_billetera decimal [note: 'cobros netos por billetera virtual; no suman al efectivo']
  total_general decimal [note: 'suma de los tres totales por medio']
  ingresos_efectivo decimal [note: 'movimientos manuales de ingreso en efectivo']
  egresos_efectivo decimal [note: 'movimientos manuales de egreso en efectivo']
  efectivo_esperado decimal [note: 'saldo inicial + total_efectivo + ingresos_efectivo - egresos_efectivo']
  efectivo_contado decimal
  diferencia decimal [note: 'efectivo contado - efectivo esperado']
  estado estado_caja [note: 'abierta pasa a cerrada, una vez; después solo cambia por la corrección autorizada']
  observaciones text [note: 'del cierre']
  corregida_por_usuario_id int [note: 'corrección autorizada del cierre: solo cambia el efectivo contado y la diferencia']
  corregida_at datetime
  motivo_correccion text [note: 'obligatorio al corregir']
  created_at datetime
  updated_at datetime

  indexes {
    ambito_id [unique, note: 'índice parcial: una sola sesión abierta por local']
  }
}

Table movimientos_caja {
  id int [pk, increment]
  sesion_caja_id int [note: 'una sesión abierta']
  usuario_id int
  origen origen_movimiento_caja [note: 'las ventas y sus devoluciones llevan venta_id; las cobranzas suman cobranza_id con el módulo 7']
  tipo tipo_movimiento_caja [note: 'venta y cobranza son ingresos; devolucion, egreso']
  rubro rubro_caja [note: 'solo en los manuales, y obligatorio; gasto, retiro y pago_fabrica son egresos y aporte es ingreso, salvo en una corrección']
  medio_pago medio_pago [note: 'efectivo, transferencia o billetera_virtual; nunca cuenta_corriente']
  monto decimal [note: 'mayor que cero; el tipo da el signo']
  fecha_hora datetime
  observacion text [note: 'obligatoria en los manuales']
  corrige_movimiento_id int [note: 'movimiento manual contrario que corrige un error: misma sesión, rubro y medio, tipo opuesto, sin pasar el monto original']
  venta_id int [note: 'la venta cobrada o devuelta (origen venta o devolucion), del mismo local que la sesión. La cobranza suma cobranza_id con el módulo 7']
  created_at datetime
  updated_at datetime
  note: 'Solo de inserción: no se modifica ni se borra.'
}

// ---------------------------------------------------------------------------
// Proveedores y compras
// ---------------------------------------------------------------------------

Table proveedores {
  id int [pk, increment]
  ambito_id int [note: 'ámbito que le compra']
  razon_social varchar
  cuit varchar
  condicion_iva condicion_iva
  contacto varchar
  tipo_provee varchar
  condiciones_comerciales text
  descuento_porcentaje decimal
  plazo_pago_dias int
  ambito_representado_id int [note: 'cuando el proveedor es la fábrica (proveedor de cada local)']
  observaciones text
  activo boolean
  created_at datetime
  updated_at datetime
}

Table ordenes_compra {
  id int [pk, increment]
  ambito_id int
  proveedor_id int
  usuario_id int
  fecha date
  estado estado_orden_compra
  observaciones text
  created_at datetime
  updated_at datetime
}

Table detalle_orden_compra {
  id int [pk, increment]
  orden_id int
  articulo_id int
  cantidad decimal
  costo_estimado decimal
  created_at datetime
  updated_at datetime
}

Table compras {
  id int [pk, increment]
  ambito_id int
  proveedor_id int
  usuario_id int
  ubicacion_stock_id int
  orden_compra_id int
  entrega_id int [note: 'cuando la compra es la recepción de una entrega de la fábrica']
  tipo tipo_compra
  fecha date
  comprobante_proveedor varchar
  fecha_vencimiento date
  total decimal
  observaciones text
  created_at datetime
  updated_at datetime
}

Table detalle_compra {
  id int [pk, increment]
  compra_id int
  articulo_id int
  cantidad decimal
  costo_unitario decimal
  subtotal decimal
  created_at datetime
  updated_at datetime
}

Table pagos_proveedor {
  id int [pk, increment]
  ambito_id int
  proveedor_id int
  usuario_id int
  sesion_caja_id int
  fecha datetime
  medio_pago medio_pago
  monto decimal
  cobranza_id int [note: 'cuando el pago es de un local a la fábrica, la cobranza que registró la fábrica']
  observaciones text
  created_at datetime
  updated_at datetime
}

Table detalle_pago_proveedor {
  id int [pk, increment]
  pago_id int
  compra_id int
  importe_aplicado decimal
  created_at datetime
  updated_at datetime
}

// ---------------------------------------------------------------------------
// Producción
// ---------------------------------------------------------------------------

Table recetas {
  id int [pk, increment]
  articulo_id int [note: 'producto terminado']
  version int
  cantidad_base decimal [note: 'cantidad de producto que rinde la receta']
  vigente boolean
  observaciones text
  created_at datetime
  updated_at datetime
}

Table receta_items {
  id int [pk, increment]
  receta_id int
  articulo_id int [note: 'insumo']
  cantidad decimal
  created_at datetime
  updated_at datetime
}

Table lotes_produccion {
  id int [pk, increment]
  numero_lote varchar [unique]
  receta_id int
  articulo_id int
  ambito_id int
  ubicacion_stock_id int
  usuario_id int
  estado estado_lote
  fecha_inicio date
  fecha_cierre date
  cantidad_producida decimal
  costo_total decimal [note: 'según el costo vigente de los insumos al cerrar']
  costo_unitario decimal
  observaciones text
  created_at datetime
  updated_at datetime
  note: 'Al cerrar el lote se descuentan los insumos y se suma el producto terminado al stock de la fábrica.'
}

Table lote_insumos {
  id int [pk, increment]
  lote_id int
  articulo_id int
  cantidad_teorica decimal [note: 'según la receta y la cantidad producida']
  cantidad_real decimal
  costo_unitario decimal
  created_at datetime
  updated_at datetime
  note: 'Merma = cantidad_real − cantidad_teorica.'
}

// ---------------------------------------------------------------------------
// Relaciones
// ---------------------------------------------------------------------------

Ref: ambitos.entidad_fiscal_id > entidades_fiscales.id
Ref: puntos_venta.entidad_fiscal_id > entidades_fiscales.id
Ref: puntos_venta.ambito_id > ambitos.id
Ref: punto_venta_comprobantes.punto_venta_id > puntos_venta.id
Ref: usuario_ambitos.usuario_id > usuarios.id
Ref: usuario_ambitos.ambito_id > ambitos.id
Ref: usuario_ambitos.creado_por_usuario_id > usuarios.id
Ref: auditorias.usuario_id > usuarios.id
Ref: auditorias.ambito_id > ambitos.id
Ref: auditorias.ambito_afectado_id > ambitos.id

Ref: articulos.ambito_id > ambitos.id
Ref: articulos.categoria_id > categorias.id
Ref: costos_articulo.articulo_id > articulos.id
Ref: costos_articulo.ambito_id > ambitos.id
Ref: listas_precios.ambito_id > ambitos.id
Ref: lista_precios_items.lista_id > listas_precios.id
Ref: lista_precios_items.articulo_id > articulos.id
Ref: historial_precios.lista_id > listas_precios.id
Ref: historial_precios.articulo_id > articulos.id
Ref: historial_precios.usuario_id > usuarios.id
Ref: promociones.ambito_id > ambitos.id
Ref: promociones.articulo_id > articulos.id
Ref: promociones.categoria_id > categorias.id

Ref: ubicaciones_stock.ambito_id > ambitos.id
Ref: stock_articulos.articulo_id > articulos.id
Ref: stock_articulos.ubicacion_stock_id > ubicaciones_stock.id
Ref: movimientos_stock.articulo_id > articulos.id
Ref: movimientos_stock.ubicacion_stock_id > ubicaciones_stock.id
Ref: movimientos_stock.lote_id > lotes_produccion.id
Ref: movimientos_stock.usuario_id > usuarios.id
Ref: movimientos_stock.venta_id > ventas.id
Ref: movimientos_stock.pedido_id > pedidos.id
Ref: movimientos_stock.compra_id > compras.id
Ref: movimientos_stock.entrega_id > entregas.id
Ref: movimientos_stock.conteo_id > conteos_stock.id
Ref: reservas_stock.pedido_id > pedidos.id
Ref: reservas_stock.detalle_pedido_id > detalle_pedidos.id
Ref: reservas_stock.articulo_id > articulos.id
Ref: reservas_stock.ubicacion_stock_id > ubicaciones_stock.id
Ref: conteos_stock.ubicacion_stock_id > ubicaciones_stock.id
Ref: conteos_stock.usuario_id > usuarios.id
Ref: detalle_conteo.conteo_id > conteos_stock.id
Ref: detalle_conteo.articulo_id > articulos.id

Ref: clientes.ambito_id > ambitos.id
Ref: clientes.lista_precios_id > listas_precios.id
Ref: clientes.ambito_representado_id > ambitos.id
Ref: pedidos.cliente_id > clientes.id
Ref: pedidos.ambito_id > ambitos.id
Ref: detalle_pedidos.pedido_id > pedidos.id
Ref: detalle_pedidos.articulo_id > articulos.id
Ref: pedido_historial.pedido_id > pedidos.id
Ref: pedido_historial.usuario_id > usuarios.id
Ref: pedido_historial.ambito_anterior_id > ambitos.id
Ref: pedido_historial.ambito_nuevo_id > ambitos.id

Ref: ventas.ambito_id > ambitos.id
Ref: ventas.usuario_id > usuarios.id
Ref: ventas.cliente_id > clientes.id
Ref: ventas.pedido_id > pedidos.id
Ref: ventas.sesion_caja_id > sesiones_caja.id
Ref: ventas.comprobante_id > comprobantes.id
Ref: ventas.anulada_por_usuario_id > usuarios.id
Ref: detalle_ventas.venta_id > ventas.id
Ref: detalle_ventas.articulo_id > articulos.id
Ref: detalle_ventas.ubicacion_stock_id > ubicaciones_stock.id
Ref: devoluciones_venta.venta_id > ventas.id
Ref: devoluciones_venta.usuario_id > usuarios.id
Ref: devoluciones_venta.nota_credito_id > comprobantes.id
Ref: devoluciones_venta.sesion_caja_id > sesiones_caja.id
Ref: detalle_devoluciones_venta.devolucion_id > devoluciones_venta.id
Ref: detalle_devoluciones_venta.detalle_venta_id > detalle_ventas.id
Ref: comprobantes.punto_venta_id > puntos_venta.id
Ref: comprobantes.cliente_id > clientes.id
Ref: comprobantes.usuario_id > usuarios.id
Ref: comprobantes.comprobante_asociado_id > comprobantes.id
Ref: detalle_comprobante.comprobante_id > comprobantes.id
Ref: detalle_comprobante.articulo_id > articulos.id

Ref: entregas.ambito_origen_id > ambitos.id
Ref: entregas.ambito_destino_id > ambitos.id
Ref: entregas.ubicacion_origen_id > ubicaciones_stock.id
Ref: entregas.ubicacion_destino_id > ubicaciones_stock.id
Ref: entregas.lista_precios_id > listas_precios.id
Ref: entregas.usuario_envio_id > usuarios.id
Ref: entregas.usuario_recepcion_id > usuarios.id
Ref: entregas.usuario_anulacion_id > usuarios.id
Ref: entregas.usuario_resolucion_id > usuarios.id
Ref: entregas.remito_id > comprobantes.id
Ref: entregas.factura_id > comprobantes.id
Ref: entregas.nota_credito_id > comprobantes.id
Ref: detalle_entregas.entrega_id > entregas.id
Ref: detalle_entregas.articulo_id > articulos.id
Ref: detalle_entregas.lote_id > lotes_produccion.id

Ref: movimientos_cuenta_corriente.ambito_id > ambitos.id
Ref: movimientos_cuenta_corriente.cliente_id > clientes.id
Ref: movimientos_cuenta_corriente.venta_id > ventas.id
Ref: movimientos_cuenta_corriente.entrega_id > entregas.id
Ref: movimientos_cuenta_corriente.cobranza_id > cobranzas.id
Ref: movimientos_cuenta_corriente.comprobante_id > comprobantes.id
Ref: movimientos_cuenta_corriente.usuario_id > usuarios.id
Ref: cobranzas.ambito_id > ambitos.id
Ref: cobranzas.cliente_id > clientes.id
Ref: cobranzas.usuario_id > usuarios.id
Ref: cobranzas.sesion_caja_id > sesiones_caja.id
Ref: cobranzas.recibo_id > comprobantes.id
Ref: detalle_cobranza.cobranza_id > cobranzas.id
Ref: detalle_cobranza.movimiento_cc_id > movimientos_cuenta_corriente.id

Ref: sesiones_caja.ambito_id > ambitos.id
Ref: sesiones_caja.usuario_apertura_id > usuarios.id
Ref: sesiones_caja.usuario_cierre_id > usuarios.id
Ref: movimientos_caja.sesion_caja_id > sesiones_caja.id
Ref: movimientos_caja.usuario_id > usuarios.id
Ref: movimientos_caja.corrige_movimiento_id > movimientos_caja.id
Ref: movimientos_caja.venta_id > ventas.id
Ref: sesiones_caja.corregida_por_usuario_id > usuarios.id

Ref: proveedores.ambito_id > ambitos.id
Ref: proveedores.ambito_representado_id > ambitos.id
Ref: ordenes_compra.ambito_id > ambitos.id
Ref: ordenes_compra.proveedor_id > proveedores.id
Ref: ordenes_compra.usuario_id > usuarios.id
Ref: detalle_orden_compra.orden_id > ordenes_compra.id
Ref: detalle_orden_compra.articulo_id > articulos.id
Ref: compras.ambito_id > ambitos.id
Ref: compras.proveedor_id > proveedores.id
Ref: compras.usuario_id > usuarios.id
Ref: compras.ubicacion_stock_id > ubicaciones_stock.id
Ref: compras.orden_compra_id > ordenes_compra.id
Ref: compras.entrega_id > entregas.id
Ref: detalle_compra.compra_id > compras.id
Ref: detalle_compra.articulo_id > articulos.id
Ref: pagos_proveedor.ambito_id > ambitos.id
Ref: pagos_proveedor.proveedor_id > proveedores.id
Ref: pagos_proveedor.usuario_id > usuarios.id
Ref: pagos_proveedor.sesion_caja_id > sesiones_caja.id
Ref: pagos_proveedor.cobranza_id > cobranzas.id
Ref: detalle_pago_proveedor.pago_id > pagos_proveedor.id
Ref: detalle_pago_proveedor.compra_id > compras.id

Ref: recetas.articulo_id > articulos.id
Ref: receta_items.receta_id > recetas.id
Ref: receta_items.articulo_id > articulos.id
Ref: lotes_produccion.receta_id > recetas.id
Ref: lotes_produccion.articulo_id > articulos.id
Ref: lotes_produccion.ambito_id > ambitos.id
Ref: lotes_produccion.ubicacion_stock_id > ubicaciones_stock.id
Ref: lotes_produccion.usuario_id > usuarios.id
Ref: lote_insumos.lote_id > lotes_produccion.id
Ref: lote_insumos.articulo_id > articulos.id
